# Docker Compose читает .env из корня проекта автоматически.
# Для локального HTTP можно оставить все значения как есть.

# Адрес публикации на хосте: 127.0.0.1 — только этот компьютер.
# Для доступа из сети укажите 0.0.0.0 или конкретный IP хоста.
BIND_ADDRESS=127.0.0.1

# Внешний порт. Внутри контейнера приложение всегда слушает 3001.
PORT=3001

# ВАЖНО: true при доступе через HTTPS reverse proxy, false для HTTP.
# Прокси должен сохранять исходный Host (включая порт, если он нестандартный).
# Сам контейнер TLS не обслуживает; сертификат настраивается на прокси.
SECURE_COOKIES=false

# HOST=0.0.0.0 и DATABASE_PATH=/app/.data/users.sqlite заданы в Compose.
# База хранится в томе app-data. Эти параметры здесь менять не требуется.
# Секреты/API-ключи для запуска не нужны; аккаунты создаются в интерфейсе.
# pnpm dev / pnpm start не читают этот файл автоматически.
