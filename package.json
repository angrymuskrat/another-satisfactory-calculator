{
  "name": "satisfactory-personal-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts --configLoader runner",
    "dev:api": "tsx watch apps/api/server.ts",
    "build": "node scripts/prepare-highs.mjs && tsc --noEmit && vite build --config apps/web/vite.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-highs.mjs && vitest run --configLoader runner",
    "start": "tsx apps/api/server.ts",
    "data:import": "node scripts/import-game-data.mjs",
    "postinstall": "node scripts/prepare-highs.mjs",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "highs": "1.15.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": { "node": ">=24.0.0" }
}
